# Reboot dev-server state.
.rbt/

# Generated code; recreated by `rbt generate`.
backend/api/
frontend/api/

# Secrets; see `lifecycle-secrets.md`.
.env

# Recordings of browser scenarios, made by running the tests.
*.recordings/

# Python virtual environment and caches.
.venv/
__pycache__/
*.py[cod]
.mypy_cache/
.pytest_cache/

# Frontend dependencies and build output (projects with a frontend).
node_modules/
frontend/dist/

# The last test run's results, and the pid of one in progress
# (tests/last_run.py).
tests/.last-run.json
tests/.suite-running
tests/.progress.jsonl

# The design step's comp: its stylesheet copy, server pid and look history
# (web-app/references/comp.md); design/comp/mockup.html, which holds its
# stylesheet, and the index.html that opens it are kept.
design/comp/*
!design/comp/mockup.html
!design/comp/index.html
design/.design.pid
design/.comp.pid
# The run skill's "restarting" page while the app is stopped
.standby.pid
